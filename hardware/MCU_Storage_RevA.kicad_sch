	(text "GPIO35/36/37: octal PSRAM, NC. GPIO43/44: limit inputs, no UART0 header.\nGPIO3 SERVICE_KEY: R53 10k pulls HIGH=open; LOW=closed. Keep default JTAG eFuses.\nKeep EFUSE_STRAP_JTAG_SEL=0; validate key states and supply sequencing during reset.\nFirmware: GPIO3/43/44 inputs, UART0 console disabled, GPIO42 UART OE only."
		(exclude_from_sim no)
		(at 160 185 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1520b90f-e610-4e6f-b060-7e7a96f54cfc")
	)
	(text "U14 reverse-blocks USB VBUS into +5V. USB alone does NOT supply the 3V3 MCU rail.\nUse the approved isolated low-voltage bench supply procedure; do not assume USB-only operation."
		(exclude_from_sim no)
		(at 80 58 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "1dffefc8-bd05-4f34-aebb-f36476bb1f42")
	)
	(text "ESP32-S3 native USB: GPIO19 = D-, GPIO20 = D+. U12 is the dedicated USB ESD array; CC1/CC2 each use 5.1k sink pull-downs."
		(exclude_from_sim no)
		(at 35 170 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
